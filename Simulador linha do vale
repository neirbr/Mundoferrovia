<title>Linha do Vale — Simulador ferroviário 2D</title>
<style>
:root{color-scheme:dark;--bg:#101913;--panel:#1b2921;--line:#52695a;--text:#f5f5e6;--muted:#bed0c2;--gold:#ffda81}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px system-ui,sans-serif}main{height:100dvh;display:grid;grid-template-rows:auto minmax(0,1fr) auto;gap:6px;padding:6px;max-width:1300px;margin:auto}header,footer{border:1px solid var(--line);background:var(--panel);border-radius:10px;padding:6px 10px}header,.actions,.lever,.readout{display:flex;align-items:center;gap:6px}header{justify-content:space-between}h1{font-size:16px;margin:0}button{font:inherit;font-weight:700;color:inherit;background:#2a4033;border:1px solid #688575;border-radius:7px;min-height:36px;padding:3px 9px;cursor:pointer}button:hover:not(:disabled){background:#405c4a}button:active:not(:disabled){transform:translateY(1px)}button:disabled{opacity:.45;cursor:not-allowed}:focus-visible{outline:3px solid var(--gold);outline-offset:2px}.stage{position:relative;display:grid;place-items:center;min-height:0;overflow:hidden;background:#132219;border:1px solid var(--line);border-radius:10px}canvas{display:block;width:min(100%,calc(var(--height, 400px) * .75));height:auto;aspect-ratio:3/4}.hud{position:absolute;top:auto;bottom:6px;left:6px;right:6px;display:flex;justify-content:space-between;gap:4px;pointer-events:none}.chip{background:#14231ef5;border:1px solid #678174;border-radius:7px;padding:4px 7px}.speed{font-size:20px;font-weight:800;font-variant-numeric:tabular-nums}.route{text-align:right}.route small{display:block}small,.sub{color:var(--muted);font-size:11px}footer{display:grid;grid-template-columns:1fr 1fr 1.4fr auto;gap:5px 12px;align-items:end}.label{display:block;font-weight:700;margin-bottom:3px}.lever button{min-width:38px}.readout{display:block;text-align:center;min-width:66px;font-variant-numeric:tabular-nums}.readout b,.readout small{display:block}.brake label{display:flex;justify-content:space-between;gap:5px}input[type=range]{width:100%;margin: