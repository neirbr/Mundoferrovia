<meta property="og:type" content="website"><meta property="og:title" content="Linha do Vale — Simulador ferroviário 2D"><meta property="og:description" content="Conduza manualmente uma locomotiva e cinco vagões pelo mapa da Linha do Vale com reversor, oito pontos de tração e freio de emergência."><meta name="twitter:card" content="summary"><meta name="twitter:title" content="Linha do Vale — Simulador ferroviário 2D"><meta name="twitter:description" content="Conduza manualmente uma locomotiva e cinco vagões pelo mapa da Linha do Vale com reversor, oito pontos de tração e freio de emergência."></head>
<body>
<main>
<header><h1>Linha do Vale</h1><div class="actions"><button id="pause">Pausar</button><button id="restart">Reiniciar</button><button id="help">Ajuda</button></div></header>
<section class="stage" id="stage" aria-label="Mapa da ferrovia visto de cima">
<canvas id="scene" width="1086" height="1448" role="img" aria-label="Mapa ferroviário com locomotiva e cinco vagões"></canvas>
<div class="hud"><div class="chip"><strong class="speed" id="speed">0</strong> km/h</div><div class="chip route"><small>ATÉ A FAIXA FINAL</small><b id="distance"></b></div></div>
<p id="error" class="error" role="alert" hidden></p>
</section>
<footer>
<div><span class="label" id="directionLabel">Direção</span><div class="lever" role="group" aria-labelledby="directionLabel"><button id="dirDown" aria-label="Direção: um passo em direção à ré">↓</button><output class="readout" id="direction" aria-live="polite"></output><button id="dirUp" aria-label="Direção: um passo em direção à frente">↑</button></div></div>
<div><span class="label" id="powerLabel">Tração</span><div class="lever" role="group" aria-labelledby="powerLabel"><button id="powerDown" aria-label="Diminuir um ponto de tração">↓</button><output class="readout" id="power" aria-live="polite"></output><button id="powerUp" aria-label="Aumentar um ponto de tração">↑</button></div></div>
<div class="brake"><label class="label" for="brake">Freio <output id="brakeValue" for="brake">0%</output></label><input id="brake" type="range" min="0" max="100" value="0"></div>
<button id="emergency" class="emergency">⚠ Emergência</button>
<div class="status"><span id="status" role="status"></span><progress id="progress" aria-label="Progresso da viagem"></progress></div>
</footer>
</main>
<dialog id="modal" aria-labelledby="modalTitle"><h2 id="modalTitle"></h2><p id="modalText"></p><button id="continue" class="primary"></button></dialog>
<script>
'use strict';
const $=id=>document.getElementById(id),canvas=$('scene'),g=canvas.getContext('2d'),brake=$('brake'),modal=$('modal');
const map=new Image();
const limits=[0,15,25,35,45,55,65,75,100];
// Centro do trilho na imagem original, da plataforma superior ao ramal inferior.
const points=4,118],[120,118],[280,118],[445,118],[775,118],[812,119],[845,124],[873,136],[896,153],[915,177],[930,206],[940,239],[945,277],[945,677],[945,717],[942,749],[934,778],[920,805],[900,826],[875,843],[846,854],[813,860],[780,862],[613,862],[578,858],[548,848],[520,833],[498,812],[482,787],[469,757],[461,723],[455,687],[454,647],[454,552],[451,515],[444,483],[434,454],[418,428],[397,406],[373,390],[346,377],[316,369],[284,365],[249,368],[213,375],[179,386],[147,402],[119,424],[94,451],[75,482],[62,516],[56,550],[55,590],[54,889],[54,1057],[55,1092],[60,1123],[69,1149],[84,1172],[104,1192],[129,1207],[158,1219],[193,1227],[228,1231],[293,1232],[328,1233],[354,1238],[382,1245],[415,1257],[446,1272],[478,1290],[509,1308],[536,1320],[566,1329],[600,1333],[920,1334;
const lengths=[0];
for(let i=1;i<points.length;i++)lengths.push(lengths[i-1]+Math.hypot(points[i][0]-points[i-1][0],points[i][1]-points[i-1][1]));
const end=lengths.at(-1),start=291,lower=185,goal=end-27,stopMin=end-49,stopMax=end-5,pixelsPerMeter=1.48;
let position=start,velocity=0,notch=0,direction=0,locked=false,ready=false,mode='loading',back='play',last=0,notice='';
function at(s){
 s=Math.max(0,Math.min(end,s));
 let lo=0,hi=lengths.length-1;
 while(hi-lo>1){const mid=(lo+hi)>>1;if(lengths[mid]<=s)lo=mid;else hi=mid}
 const a=points[lo],b=points[hi],t=(s-lengths[lo])/(lengths[hi]-lengths[lo]);
 return [a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t];
}
function render(){
 if(!ready)return;
 g.drawImage(map,0,0,1086,1448);
 const [x,y]=at(stopMin),[x2]=at(stopMax);
 g.fillStyle='#ffdc6c77';g.fillRect(x,y-14,x2-x,28);
 g.fillStyle='#ffe18c';g.fillRect(x,y-15,3,30);g.fillRect(x2-3,y-15,3,30);
 g.fillStyle='#18281d';g.fillRect(740,1285,180,29);
 g.font='bold 17px system-ui';g.fillStyle='#ffe18c';g.textAlign='center';g.fillText('PARADA FINAL',830,1306);
 for(let i=5;i>=0;i--){
   const s=position-20-i*30,[cx,cy]=at(s),[ax,ay]=at(s-8),[bx,by]=at(s+8);
   g.save();g.translate(cx,cy);g.rotate(Math.atan2(by-ay,bx-ax));g.scale(1.12,1.55);
   g.fillStyle='#141c16';g.fillRect(-13,-6,26,13);if(i)g.fillRect(12,-2,4,4);
   g.fillStyle=i?'#287385':'#b54224';g.fillRect(-12,-5,24,10);
   g.fillStyle=i?'#82c5cc':'#f58c48';g.fillRect(-9,-4,18,3);
   if(i){g.fillStyle='#d3efe4';for(let j=-8;j<9;j+=5)g.fillRect(j,1,3,2)}
   else{g.fillStyle='#263d3c';g.fillRect(-7,-4,5,8);g.fillStyle='#fff19a';g.fillRect(9,-3,3,2);g.fillRect(9,2,3,2)}
   g.restore();
 }
}
function sync(){
 $('speed').textContent=Math.round(Math.abs(velocity)*3.6);
 $('distance').textContent=Math.max(0,Math.ceil((stopMin-position)/pixelsPerMeter)).toLocaleString('pt-BR')+' m';
 $('progress').value=Math.max(0,(position-start)/(goal-start));
 const status=!ready?'Mapa indisponível para condução.':locked?(velocity?'Emergência aplicada · aguarde a parada':'Composição parada · alivie o freio de emergência'):notice|| (position>=stopMin?'Faixa final · pare em neutro':position<start+120?'Estação de partida':position<lengths[35]?'Área rural':position<lengths[46]?'Bosque do Vale':position<lengths[61]?'Área urbana':'Ramal final');
 if($('status').textContent!==status)$('status').textContent=status;
 $('emergency').disabled=!ready||locked&&velocity!==0;
}
function controls(){
 $('direction').innerHTML='<b>'+['Ré','Neutro','Frente'][direction+1]+'</b><small>Reversor</small>';
 $('power').innerHTML='<b>Ponto '+notch+'</b><small>'+(notch?'Até '+limits[notch]+' km/h':'Sem tração')+'</small>';
 $('brakeValue').textContent=brake.value+'%';
 brake.setAttribute('aria-valuetext',brake.value+' por cento');
 for(const [id,blocked] of 'dirDown',direction===-1],['dirUp',direction===1],['powerDown',notch===0],['powerUp',notch===8)$(id).disabled=!ready||locked||blocked;
 brake.disabled=!ready||locked;
 $('emergency').textContent=locked?'Aliviar freio':'⚠ Emergência';
 $('pause').disabled=$('restart').disabled=!ready;
 sync();
}
function reset(){position=start;velocity=0;notch=0;direction=0;locked=false;brake.value=0;notice='';mode='play';controls();render()}
function shift(d){
 if(mode!=='play'||locked)return;
 direction=Math.max(-1,Math.min(1,direction+d));notice='';
 if(direction*velocity<0)notice='Sentido oposto selecionado · fre/ie até parar antes de inverter.'.replace('fre/ie','freie');
 controls();
}
function power(d){if(mode==='play'&&!locked){notch=Math.max(0,Math.min(8,notch+d));notice='';controls()}}
$('dirDown').addEventListener('click',()=>shift(-1));$('dirUp').addEventListener('click',()=>shift(1));
$('powerDown').addEventListener('click',()=>power(-1));$('powerUp').addEventListener('click',()=>power(1));
brake.addEventListener('input',()=>{notice='';controls()});
function emergency(){
 if(mode!=='play')return;
 if(!locked){locked=true;notice=''}
 else if(!velocity){locked=false;brake.value=0;notch=0;notice='Freio aliviado · selecione um ponto de tração.'}
 controls();
}
$('emergency').addEventListener('click',emergency);
const guide='Use ↑ e ↓ em cada seletor para mudar um estágio. A direção passa por Ré, Neutro e Frente. Com o reversor em neutro, nenhum ponto de tração move o trem parado. Engate um sentido para acelerar gradualmente até o limite do ponto escolhido.\n\nArraste o freio para dosar a frenagem. A emergência bloqueia os comandos até a parada total; então use Aliviar freio. Para concluir, pare com a frente da locomotiva na faixa amarela do ramal inferior e deixe a tração em 0.\n\nTeclado: ↑/↓ no seletor em foco, W/S para direção, A/D para tração, E para emergência ou alívio e P para pausar.';
function show(type){
 if(type==='help')back=mode;
 mode=type;
 const copy={start:['Assuma a condução',guide,'Iniciar viagem'],help:['Como conduzir',guide,'Voltar'],pause:['Viagem pausada','Os comandos serão mantidos ao retomar.','Retomar'],win:['Chegada concluída','Você estacionou a locomotiva e os cinco vagões no ramal final.','Nova viagem']}[type];
 $('modalTitle').textContent=copy[0];$('modalText').textContent=copy[1];$('continue').textContent=copy[2];
 if(!modal.open)modal.showModal();
}
function advance(){
 if(mode==='start'||mode==='win')reset();
 else mode=mode==='help'?back:'play';
 modal.close();
}
$('continue').addEventListener('click',advance);
modal.addEventListener('cancel',e=>{e.preventDefault();if(mode==='help'||mode==='pause')advance()});
$('help').addEventListener('click',()=>show('help'));$('pause').addEventListener('click',()=>show('pause'));$('restart').addEventListener('click',reset);
document.addEventListener('keydown',e=>{
 if(mode!=='play'||e.altKey||e.ctrlKey||e.metaKey)return;
 const key=e.key.toLowerCase(),vertical=key==='arrowup'||key==='arrowdown',id=e.target.id;
 const action=vertical&&id.startsWith('dir')?()=>shift(key==='arrowup'?1:-1):vertical&&id.startsWith('power')?()=>power(key==='arrowup'?1:-1):({w:()=>shift(1),s:()=>shift(-1),a:()=>power(-1),d:()=>power(1),e:emergency,p:()=>show('pause'),escape:()=>show('pause')})[key];
 if(typeof action==='function'){e.preventDefault();if(!e.repeat)action()}
});
function frame(time){
 const dt=Math.min(.05,(time-(last||time))/1000);last=time;
 if(mode==='play'){
 const speed=Math.abs(velocity),sign=Math.sign(velocity),b=Number(brake.value)/100,cap=limits[notch]/3.6;
 let amount=speed;
 if(locked||b>0)amount=Math.max(0,speed-(locked?2.9:.11+2.05*b)*dt);
 else if(!direction||!notch||sign&&sign!==direction)amount=Math.max(0,speed-.085*dt);
 else if(speed<cap)amount=Math.min(cap,speed+(.42+notch*.088)*dt);
 else if(speed>cap)amount=Math.max(cap,speed-.28*dt);
 velocity=amount*(sign||direction);
 position+=velocity*dt*pixelsPerMeter;
 if(position<lower||position>end){
   position=Math.max(lower,Math.min(end,position));velocity=0;
   notice='Fim do trilho · selecione o sentido oposto para voltar.';
 }
 if(!locked&&!velocity&&!notch&&position>=stopMin&&position<=stopMax)show('win');
 sync();render();
 }
 requestAnimationFrame(frame);
}
